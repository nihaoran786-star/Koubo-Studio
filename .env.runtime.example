# 口播智能体真实 runtime 验收模板
# 复制为 .env.runtime.local 或 .env.local 后再填真实值；不要提交本机 env 文件。
# 命令会自动读取 .env.runtime.local 和 .env.local；shell 中显式设置的变量优先级最高。
# 如需使用其它文件，可设置 RUNTIME_ENV_FILE=C:\path\to\runtime.env。
# 未准备真实后端或账号时，保持 RUN_* 为空或 0，smoke 会安全跳过。

# Runtime profile controls which readiness checks are required for the current machine.
# Options: base, local_enhanced, publish_enhanced, remote_runtime, full.
# base keeps the main app light; heavy runtimes become optional warnings.
KOUBO_RUNTIME_PROFILE=base

# Shared media tools
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe

# AI 文案 Provider 真实链路 smoke
RUN_MODEL_PROVIDER_SMOKE=0
MODEL_PROVIDER_SMOKE_BACKEND_URL=http://127.0.0.1:3100
# Default smoke uses the provider already saved in Settings. Set to 1 only when the smoke should write a temporary provider config.
MODEL_PROVIDER_SMOKE_CONFIGURE_PROVIDER=0
MODEL_PROVIDER_SMOKE_PROVIDER_ID=deepseek
MODEL_PROVIDER_SMOKE_BASE_URL=https://api.deepseek.com/v1
MODEL_PROVIDER_SMOKE_MODEL=deepseek-chat
MODEL_PROVIDER_SMOKE_API_KEY=

# IndexTTS2 real runtime smoke
RUN_INDEXTTS2_INTEGRATION=0
RUN_DIGITAL_HUMAN_CHAIN_SMOKE=0
# Required for local-file Duix chain smoke when the Duix container reads from a mounted host directory.
KOUBO_WORKSPACES_ROOT=C:\path\to\duix-avatar\face2face\koubo-workspaces
INDEXTTS2_RUNTIME_ROOT=C:\path\to\indextts2-runtime
INDEXTTS2_REFERENCE_AUDIO=C:\path\to\reference.wav
INDEXTTS2_SCRIPT_PATH=C:\Users\17949\Documents\应聘\skills\natural-tts-voice-cloning\scripts\Invoke-NaturalTTS.ps1
INDEXTTS2_TIMEOUT_MS=180000

# Duix-Avatar / HeyGem-compatible real runtime smoke
RUN_HEYGEM_INTEGRATION=0
DUIX_AVATAR_API_URL=http://127.0.0.1:8383
DUIX_AVATAR_API_KEY=
DUIX_AVATAR_API_DIALECT=duix_face2face
DUIX_AVATAR_PUBLIC_ASSET_BASE_URL=https://your-public-app-origin.example.com
DUIX_AVATAR_RESULT_ROOT=C:\path\to\duix-avatar\face2face\results
DUIX_AVATAR_HOST_DATA_ROOT=C:\path\to\duix-avatar\face2face
DUIX_AVATAR_CONTAINER_DATA_ROOT=/code/data
DUIX_AVATAR_SCRIPT_PATH=
DUIX_AVATAR_INTEGRATION_AUDIO=C:\path\to\generated-audio.wav
DUIX_AVATAR_INTEGRATION_AVATAR_ID=default
# duix_face2face expects a video avatar asset for real validation; jpg/png often fail Duix preprocessing.
DUIX_AVATAR_INTEGRATION_AVATAR_ASSET=C:\path\to\avatar-source.mp4
DUIX_AVATAR_TIMEOUT_MS=180000
DUIX_AVATAR_POLL_INTERVAL_MS=2000
DUIX_AVATAR_API_REACHABILITY_TIMEOUT_MS=3000
HEYGEM_API_URL=http://127.0.0.1:8383
HEYGEM_API_KEY=
# compatible_render calls POST /render. duix_face2face calls POST /easy/submit and GET /easy/query?code=...
HEYGEM_API_DIALECT=compatible_render
# duix_face2face preflight probes GET /easy/query?code=__koubo_preflight__ before submitting real tasks.
# Required for remote/Docker Duix backends that cannot read local Windows paths directly.
HEYGEM_PUBLIC_ASSET_BASE_URL=https://your-public-app-origin.example.com
HEYGEM_RESULT_ROOT=C:\path\to\heygem\face2face\results
HEYGEM_HOST_DATA_ROOT=C:\path\to\heygem\face2face
HEYGEM_CONTAINER_DATA_ROOT=/code/data
HEYGEM_SCRIPT_PATH=
HEYGEM_INTEGRATION_AUDIO=C:\path\to\generated-audio.wav
HEYGEM_INTEGRATION_AVATAR_ID=default
HEYGEM_INTEGRATION_AVATAR_ASSET=C:\path\to\avatar-source.mp4
HEYGEM_TIMEOUT_MS=180000
HEYGEM_POLL_INTERVAL_MS=2000
HEYGEM_API_REACHABILITY_TIMEOUT_MS=3000
# Optional: set to 1 when you want settings/doctor to probe configured runtime ports.
RUN_RUNTIME_READINESS_NETWORK_CHECK=0

# Post-production skill smoke
RUN_POST_PRODUCTION_LOCAL_SKILL_SMOKE=0
POST_PRODUCTION_SKILL_SCRIPT_PATH=C:\Users\17949\Documents\应聘\口播智能体\scripts\Invoke-BuiltinPostProductionSkill.ps1
POST_PRODUCTION_SMOKE_OUTPUT_ROOT=C:\Users\17949\Documents\应聘\口播智能体\data\workspaces

PLAYWRIGHT_TEST_BASE_URL=http://127.0.0.1:3112
PLAYWRIGHT_REUSE_EXISTING_SERVER=0

# Desktop backend / release smoke
NEXT_PUBLIC_DESKTOP_LOCAL_BACKEND_URL=http://127.0.0.1:3100
RUN_DESKTOP_BACKEND_SMOKE=0
DESKTOP_LOCAL_BACKEND_URL=http://127.0.0.1:3100
RUN_DESKTOP_RELEASE_SMOKE=0
DESKTOP_RELEASE_EXE_PATH=C:\Users\17949\Documents\应聘\口播智能体\src-tauri\target\release\koubo-agent.exe
DESKTOP_BACKEND_NODE_PATH=C:\path\to\node.exe
